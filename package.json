{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio and blog built with Astro, React 19, and Tailwind CSS v4.",
  "homepage": "https://yunosukeyoshino.com",
  "bugs": {
    "url": "https://github.com/YunosukeYoshino/Portfolio/issues"
  },
  "license": "MIT",
  "author": "Yunosuke Yoshino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunosukeYoshino/Portfolio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bun run lint:oxlint && bun run lint:oxfmt && bun run lint:tsc && bun run lint:markup",
    "lint:oxlint": "oxlint .",
    "lint:oxfmt": "oxfmt --check .",
    "lint:tsc": "tsc --noEmit",
    "lint:markup": "markuplint 'src/**/*.{jsx,tsx}'",
    "fix": "bun run fix:oxlint && bun run format",
    "fix:oxlint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "wrangler": "wrangler",
    "cf:typegen": "wrangler types",
    "seo:optimize": "bun run scripts/seo-optimize.ts",
    "seo:optimize:force": "bun run scripts/seo-optimize.ts --force",
    "seo:optimize:dry": "bun run scripts/seo-optimize.ts --dry-run",
    "verify:deployment": "bun run scripts/verify-deployment-assets.ts",
    "lighthouse": "bun run build && lhci autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.1.3",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/typescript-estree": "^8.65.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markuplint": "^4.18.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": "^8.65.0",
    "diff": ">=8.0.3",
    "mdast-util-to-hast": ">=13.2.1",
    "picomatch": ">=2.3.2",
    "undici": ">=7.25.0 <8",
    "uuid": ">=14.0.0",
    "yaml": ">=2.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write",
      "markuplint"
    ],
    "*.astro": [
      "oxlint --fix"
    ],
    "src/**/*.{json,css,scss}": [
      "oxfmt --write"
    ]
  },
  "trustedDependencies": []
}
