{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio and blog built with Astro, React 19, and Tailwind CSS v4.",
  "homepage": "https://yunosukeyoshino.com",
  "bugs": {
    "url": "https://github.com/YunosukeYoshino/Portfolio/issues"
  },
  "license": "MIT",
  "author": "Yunosuke Yoshino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunosukeYoshino/Portfolio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "lint": "vp check",
    "fix": "vp lint --fix . && vp fmt",
    "format": "vp fmt",
    "deploy": "bun run build && cf-wrangler build && grep -E '^(MICROCMS_SERVICE_DOMAIN|MICROCMS_API_KEY|RESEND_API_KEY)=' .env.local > .worker-secrets.env && cf deploy --prebuilt --secrets-file .worker-secrets.env && rm -f .worker-secrets.env",
    "deploy:preview": "bun run build && cf-wrangler build --mode preview && cf deploy --prebuilt --mode preview",
    "cf:typegen": "cf workers types",
    "seo:optimize": "bun run scripts/seo-optimize.ts",
    "seo:optimize:force": "bun run scripts/seo-optimize.ts --force",
    "seo:optimize:dry": "bun run scripts/seo-optimize.ts --dry-run",
    "verify:deployment": "bun run scripts/verify-deployment-assets.ts",
    "lighthouse": "bun run build && lhci autorun",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.1.3",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cf": "1.0.0-beta.5",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "wrangler": "^4.136.0"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "mdast-util-to-hast": ">=13.2.1",
    "picomatch": ">=2.3.2",
    "undici": ">=7.25.0 <8",
    "uuid": ">=14.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "yaml": ">=2.8.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "trustedDependencies": []
}
