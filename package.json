{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio and blog built with Astro, React 19, and Tailwind CSS v4.",
  "license": "MIT",
  "author": "Yunosuke Yoshino",
  "homepage": "https://yunosukeyoshino.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunosukeYoshino/Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/YunosukeYoshino/Portfolio/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && echo '_worker.js' > dist/.assetsignore && echo '_routes.json' >> dist/.assetsignore",
    "preview": "astro build && astro preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bun run lint:biome && bun run lint:tsc && bun run lint:markup",
    "lint:biome": "biome check .",
    "lint:tsc": "tsc --noEmit",
    "lint:markup": "markuplint 'src/**/*.{jsx,tsx}'",
    "fix": "bun run fix:biome && bun run format",
    "fix:biome": "biome check --fix .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci": "biome ci .",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "wrangler": "wrangler",
    "cf:typegen": "wrangler types",
    "seo:optimize": "bun run scripts/seo-optimize.ts",
    "seo:optimize:force": "bun run scripts/seo-optimize.ts --force",
    "seo:optimize:dry": "bun run scripts/seo-optimize.ts --dry-run",
    "verify:deployment": "bun run scripts/verify-deployment-assets.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markuplint": "^4.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "undici": ">=7.25.0 <8",
    "uuid": ">=14.0.0",
    "yaml": ">=2.8.3",
    "picomatch": ">=2.3.2",
    "diff": ">=8.0.3",
    "mdast-util-to-hast": ">=13.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --unsafe",
      "markuplint"
    ],
    "src/**/*.{json,css,scss}": [
      "biome format --write"
    ]
  },
  "trustedDependencies": []
}
