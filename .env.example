# Development environment variables
# Copy to .env.local and fill in. All values are optional in development:
# microCMS-backed routes fall back to mock data when credentials are missing.

# microCMS Configuration (required for real article data)
MICROCMS_SERVICE_DOMAIN=""
MICROCMS_API_KEY=""

# Resend API Configuration (required for the contact form)
RESEND_API_KEY=""

# Cloudflare Configuration (required only for local `bun run deploy`)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
