---
import '../globals.css'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import {
  DEFAULT_OG_IMAGE_URL,
  GA_TRACKING_ID,
  GOOGLE_SITE_VERIFICATION,
  toCanonicalUrl,
} from '@/lib/siteMetadata'

interface Props {
  /** Render the site name as the page h1. Only the index page should set this. */
  readonly siteRoot?: boolean
  readonly title?: string
  readonly description?: string
  readonly robots?: string
  readonly ogType?: 'website' | 'article'
  readonly image?: string
  readonly canonicalPath?: string
}

const {
  siteRoot = false,
  title = 'Yunosuke Yoshino',
  description,
  robots,
  ogType = 'website',
  image,
  canonicalPath,
} = Astro.props

const canonicalUrl = canonicalPath ? toCanonicalUrl(canonicalPath) : undefined
const ogImage = image ?? DEFAULT_OG_IMAGE_URL
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {/* LLM クライアント向けの発見手がかり（HTTP Link ヘッダの静的ルート代替） */}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="application/xml" href="/sitemap.xml" />
    {GA_TRACKING_ID && (
      <Fragment>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}
        />
        <script is:inline define:vars={{ GA_TRACKING_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {{ dataLayer.push(arguments); }}
          gtag('js', new Date());
          gtag('config', GA_TRACKING_ID);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <div class="measure relative z-[2] pt-[var(--pagetop)] pb-[var(--pagebottom)]">
      <Header siteRoot={siteRoot} />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>
