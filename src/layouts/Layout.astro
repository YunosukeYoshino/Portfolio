---
import '../globals.css'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import {
  DEFAULT_OG_IMAGE_URL,
  GA_TRACKING_ID,
  GOOGLE_SITE_VERIFICATION,
  toCanonicalUrl,
} from '@/lib/siteMetadata'

interface Props {
  /** Render the site name as the page h1. Only the index page should set this. */
  readonly siteRoot?: boolean
  readonly title?: string
  readonly description?: string
  readonly robots?: string
  readonly ogType?: 'website' | 'article'
  readonly image?: string
  readonly canonicalPath?: string
}

const DEFAULT_DESCRIPTION =
  'Personal portfolio and blog of Yunosuke Yoshino. Frontend engineer focused on high-performance web applications, React, Astro, and AI agents.'

const {
  siteRoot = false,
  title = 'Yunosuke Yoshino',
  description = DEFAULT_DESCRIPTION,
  robots,
  ogType = 'website',
  image,
  canonicalPath,
} = Astro.props

const canonicalUrl = canonicalPath ? toCanonicalUrl(canonicalPath) : undefined
const pageDescription = description || DEFAULT_DESCRIPTION
const ogImage = image ?? DEFAULT_OG_IMAGE_URL
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* Google Fonts: Crimson Pro */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300..600;1,300..600&display=swap" rel="stylesheet" />
    {/* ファビコン・アイコン（実体は public/assets/icons/ 配下） */}
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/icon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F3F3F1" />
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {/* LLM クライアント向けの発見手がかり（HTTP Link ヘッダの静的ルート代替） */}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="application/xml" href="/sitemap.xml" />
    {GA_TRACKING_ID && (
      <Fragment>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}
        />
        <script is:inline define:vars={{ GA_TRACKING_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {{ dataLayer.push(arguments); }}
          gtag('js', new Date());
          gtag('config', GA_TRACKING_ID);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <div class="measure relative z-[2] pt-[var(--pagetop)] pb-[var(--pagebottom)]">
      <Header siteRoot={siteRoot} />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>
