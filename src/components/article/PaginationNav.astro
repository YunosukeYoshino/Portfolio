---
import { buildPaginationModel } from '@/lib/pagination'
import { cn } from '@/lib/utils'

interface Props {
  readonly currentPage: number
  readonly totalPages: number
  readonly ariaLabel: string
  readonly getPageHref: (page: number) => string
}

const { currentPage, totalPages, ariaLabel, getPageHref } = Astro.props
const model = buildPaginationModel({ currentPage, totalPages })

const activeClass = 'text-ink underline underline-offset-4'
const inactiveClass = 'text-ink-label hover:text-ink'
const baseClass = 'font-mono text-[13px] transition-colors'
const navClass = 'font-mono text-[13px] text-ink-label transition-colors hover:text-ink'
---

<nav class="flex items-center justify-center gap-4 pt-10" aria-label={ariaLabel}>
  {
    model.hasPrevious &&
      model.previousPage !== null && (
        <a class={navClass} href={getPageHref(model.previousPage)} rel="prev" aria-label="前のページ">
          <span aria-hidden="true">←</span>
        </a>
      )
  }
  {
    model.showFirstPage && (
      <>
        <a class={`${baseClass} ${inactiveClass}`} href={getPageHref(1)}>
          {1}
        </a>
        {model.hasLeadingEllipsis && <span class="meta-mono">…</span>}
      </>
    )
  }
  {
    model.pages.map((page) => (
      <a
        class={cn(baseClass, page === currentPage ? activeClass : inactiveClass)}
        href={getPageHref(page)}
        aria-current={page === currentPage ? 'page' : undefined}
      >
        {page}
      </a>
    ))
  }
  {
    model.showLastPage && (
      <>
        {model.hasTrailingEllipsis && <span class="meta-mono">…</span>}
        <a class={`${baseClass} ${inactiveClass}`} href={getPageHref(totalPages)}>
          {totalPages}
        </a>
      </>
    )
  }
  {
    model.hasNext &&
      model.nextPage !== null && (
        <a class={navClass} href={getPageHref(model.nextPage)} rel="next" aria-label="次のページ">
          <span aria-hidden="true">→</span>
        </a>
      )
  }
</nav>
