---
interface Props {
  readonly backUrl?: string
  readonly backLabel?: string
}

const { backUrl = '/article/page/1', backLabel = 'Writing' } = Astro.props
---

<aside class="hidden min-[1280px]:block fixed left-0 top-0 bottom-0 z-50 pointer-events-none" aria-label="Article navigation">
  <div class="relative flex flex-col gap-6 pt-[200px] pl-12 pointer-events-auto">
    <a
      class="flex items-center gap-2 w-fit text-sm font-medium text-ink-label hover:text-ink transition-colors duration-300 active:scale-[0.97] px-3 py-2 -mx-3 -my-2 rounded"
      aria-label={`Back to ${backLabel}`}
      href={backUrl}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4 flex-shrink-0"
        aria-hidden="true"
      >
        <path d="M9 14 4 9l5-5"></path>
        <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path>
      </svg>
      {backLabel}
    </a>
  </div>

  <button
    id="back-to-top-btn"
    type="button"
    class="pointer-events-auto fixed bottom-16 left-12 flex items-center gap-2 w-fit text-sm font-medium text-ink-label hover:text-ink transition-all duration-300 opacity-0 blur-[4px] pointer-events-none cursor-pointer px-3 py-2 -mx-3 -my-2 rounded"
    aria-label="Back to top"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4 flex-shrink-0"
      aria-hidden="true"
    >
      <path d="m5 12 7-7 7 7"></path>
      <path d="M12 19V5"></path>
    </svg>
    Back to top
  </button>
</aside>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn')
    if (!btn) return

    function handleScroll() {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'blur-[4px]', 'pointer-events-none')
        btn.classList.add('opacity-100', 'blur-none')
      } else {
        btn.classList.add('opacity-0', 'blur-[4px]', 'pointer-events-none')
        btn.classList.remove('opacity-100', 'blur-none')
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })

    handleScroll()
  }

  setupBackToTop()
  document.addEventListener('astro:after-swap', setupBackToTop)
</script>
