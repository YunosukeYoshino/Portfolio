---
import { getEntry } from 'astro:content'
import ArticleCta from '@/components/article/ArticleCta.astro'
import JsonLdScript from '@/components/seo/JsonLdScript.astro'
import { createArticleSchema, createBreadcrumbSchema } from '@/components/seo/JsonLd'
import Layout from '@/layouts/Layout.astro'
import { renderArticleContent } from '@/lib/articleRender'
import { getSeoMetadata } from '@/lib/seoMetadata'
import { toCanonicalUrl } from '@/lib/siteMetadata'
import { formatDate } from '@/lib/utils'

// Accept: text/markdown 配信（middleware）を有効にするため SSR 化。
export const prerender = false

const { slug } = Astro.params
if (!slug) {
  return new Response('Not Found', { status: 404 })
}

const entry = await getEntry('articles', slug)
if (!entry) {
  return new Response('Not Found', { status: 404 })
}

const article = entry.data
const renderedContent = await renderArticleContent(article.content)
const description = article.content.replace(/<[^>]+>/g, '').slice(0, 120)
const seo = getSeoMetadata(slug)
const articleSchema = createArticleSchema({ ...article, id: slug }, seo ?? undefined)
const breadcrumbSchema = createBreadcrumbSchema([
  { name: 'ホーム', url: toCanonicalUrl('/') },
  { name: '記事一覧', url: toCanonicalUrl('/article/page/1') },
  { name: article.title, url: toCanonicalUrl(`/article/${slug}`) },
])
---

<Layout
  title={`${article.title} | Yunosuke Yoshino`}
  description={description}
  canonicalPath={`/article/${slug}`}
  ogType="article"
  image={article.eyecatch?.url}
>
  <JsonLdScript data={articleSchema} />
  <JsonLdScript data={breadcrumbSchema} />
  <article class="mb-[var(--sectiongap)]">
    <nav
      aria-label="パンくずリスト"
      class="meta-mono mb-8 flex flex-wrap items-center gap-2 text-xs text-ink-faint"
    >
      <a class="transition-colors hover:text-ink" href="/">Home</a>
      <span aria-hidden="true" class="opacity-40">/</span>
      <a class="transition-colors hover:text-ink" href="/article/page/1">Writing</a>
      <span aria-hidden="true" class="opacity-40">/</span>
      <span class="text-ink truncate max-w-[200px] sm:max-w-none">{article.title}</span>
    </nav>

    <header class="mb-12">
      <div class="meta-mono mb-4 flex items-center gap-3 text-xs text-ink-label">
        <span class="px-2 py-0.5 rounded bg-ink/5 text-ink-body font-mono text-[11px] uppercase tracking-wider">{article.category.name}</span>
        <span aria-hidden="true" class="opacity-40">•</span>
        <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif italic text-ink leading-tight tracking-tight mb-6">
        {article.title}
      </h1>

      {
        article.eyecatch && (
          <img
            src={`${article.eyecatch.url}?w=1200&fm=webp`}
            alt={article.eyecatch.alt || article.title}
            width={1200}
            height={675}
            class="mt-8 aspect-video w-full object-cover rounded-md"
          />
        )
      }
    </header>

    <div
      class="prose prose-base sm:prose-lg max-w-none text-ink-body leading-relaxed prose-headings:font-medium prose-headings:tracking-tight prose-headings:text-ink prose-a:font-medium prose-a:text-ink prose-a:underline prose-a:underline-offset-4 prose-a:decoration-rule-strong hover:prose-a:decoration-ink prose-blockquote:border-l-2 prose-blockquote:border-rule-strong prose-blockquote:bg-ink/5 prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:not-italic prose-blockquote:text-ink-soft prose-code:font-mono prose-code:text-[0.875em] prose-code:bg-ink/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:before:content-none prose-code:after:content-none prose-img:rounded-md prose-img:my-8"
      set:html={renderedContent}
    />

    <footer class="mt-16 pt-6">
      <a class="meta-mono transition-colors hover:text-ink text-ink-label flex items-center gap-2" href="/article/page/1">
        <span>←</span>
        <span>Back to all writing</span>
      </a>
    </footer>
  </article>

  <ArticleCta />
</Layout>
