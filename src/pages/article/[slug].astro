---
import { getCollection, getEntry } from 'astro:content'
import ArticleCta from '@/components/article/ArticleCta.astro'
import ArticleSidebar from '@/components/article/ArticleSidebar.astro'
import JsonLdScript from '@/components/seo/JsonLdScript.astro'
import { createArticleSchema, createBreadcrumbSchema } from '@/components/seo/JsonLd'
import Layout from '@/layouts/Layout.astro'
import { renderArticleContent } from '@/lib/article/render'
import { getSeoMetadata } from '@/lib/seoMetadata'
import { toCanonicalUrl } from '@/lib/siteMetadata'
import { formatDate } from '@/lib/utils'

// Accept: text/markdown 配信（middleware）を有効にするため SSR 化。
export const prerender = false

const { slug } = Astro.params
if (!slug) {
  return new Response('Not Found', { status: 404 })
}

const entry = await getEntry('articles', slug)
if (!entry) {
  return new Response('Not Found', { status: 404 })
}

const article = entry.data
const renderedContent = await renderArticleContent(article.content)
const description = article.content.replace(/<[^>]+>/g, '').slice(0, 120)
const seo = getSeoMetadata(slug)
const articleSchema = createArticleSchema({ ...article, id: slug }, seo ?? undefined)
const breadcrumbSchema = createBreadcrumbSchema([
  { name: 'ホーム', url: toCanonicalUrl('/') },
  { name: '記事一覧', url: toCanonicalUrl('/article/page/1') },
  { name: article.title, url: toCanonicalUrl(`/article/${slug}`) },
])

const allArticles = await getCollection('articles')
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)
const currentIndex = sortedArticles.findIndex((item) => item.id === slug)
const nextArticle = currentIndex > 0 ? sortedArticles[currentIndex - 1] : null
const prevArticle = currentIndex < sortedArticles.length - 1 ? sortedArticles[currentIndex + 1] : null
---

<Layout
  title={`${article.title} | Yunosuke Yoshino`}
  description={description}
  canonicalPath={`/article/${slug}`}
  ogType="article"
  image={article.eyecatch?.url}
>
  <JsonLdScript data={articleSchema} />
  <JsonLdScript data={breadcrumbSchema} />

  {/* 左側固定デスクトップナビゲーション */}
  <ArticleSidebar backUrl="/article/page/1" backLabel="Writing" />

  <div class="relative w-full min-h-screen">
    {/* 背景ドットグリッド */}
    <div aria-hidden="true" class="paper-grid-background"></div>

    {/* メイン記事コンテナ (Sue Park 風のペーパーカードレイアウト) */}
    <main class="relative z-10 w-full min-[1280px]:pl-[240px] pt-6 sm:pt-10 md:pt-14 pb-20">
      <div class="px-6 min-[1280px]:px-0 max-w-[560px] mx-auto">
        {/* モバイル用パンくずナビ */}
        <nav
          aria-label="パンくずリスト"
          class="meta-mono mb-8 flex min-[1280px]:hidden flex-wrap items-center gap-2 text-xs text-ink-faint"
        >
          <a class="transition-colors hover:text-ink" href="/">Home</a>
          <span aria-hidden="true" class="opacity-40">/</span>
          <a class="transition-colors hover:text-ink" href="/article/page/1">Writing</a>
          <span aria-hidden="true" class="opacity-40">/</span>
          <span class="text-ink truncate max-w-[180px]">{article.title}</span>
        </nav>

        <header class="mb-12 text-left">
          <p class="text-sm font-sans text-ink-label mb-3">
            {article.category.name} · <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
          </p>

          <h1 class="text-3xl sm:text-4xl lg:text-[40px] font-serif text-ink leading-[1.22] tracking-tight text-balance mb-8 font-normal">
            {article.title}
          </h1>

          {
            article.eyecatch && (
              <img
                src={`${article.eyecatch.url}?w=1200&fm=webp`}
                alt={article.eyecatch.alt || article.title}
                width={1200}
                height={675}
                class="mt-6 aspect-video w-full object-cover rounded-md border border-rule/40"
              />
            )
          }
        </header>

        {/* 記事本文 */}
        <div
          class="prose prose-base text-ink-body leading-relaxed max-w-[560px] mx-auto prose-headings:font-serif prose-a:font-medium prose-a:underline prose-a:underline-offset-4 prose-a:decoration-rule-strong hover:prose-a:decoration-ink"
          set:html={renderedContent}
        />

        {/* 記事フッター＆前後ナビゲーション */}
        <footer class="mt-16 pt-8 border-t border-rule/60">
          <div class="flex justify-between items-start gap-8">
            <div class="flex-1 text-left">
              {prevArticle && (
                <a class="group inline-flex flex-col no-underline" href={`/article/${prevArticle.id}`}>
                  <span class="text-xs font-sans text-ink-label mb-1.5 flex items-center gap-1.5 group-hover:text-ink transition-colors">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-3.5 transition-transform duration-300 group-hover:-translate-x-1"
                    >
                      <path d="M19 12H5"></path>
                      <path d="m12 19-7-7 7-7"></path>
                    </svg>
                    Previous
                  </span>
                  <span class="font-serif text-base sm:text-lg text-ink font-normal leading-snug group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
                    {prevArticle.data.title}
                  </span>
                </a>
              )}
            </div>

            <div class="flex-1 text-right">
              {nextArticle && (
                <a class="group inline-flex flex-col items-end no-underline" href={`/article/${nextArticle.id}`}>
                  <span class="text-xs font-sans text-ink-label mb-1.5 flex items-center gap-1.5 group-hover:text-ink transition-colors">
                    Next
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-3.5 transition-transform duration-300 group-hover:translate-x-1"
                    >
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </span>
                  <span class="font-serif text-base sm:text-lg text-ink font-normal leading-snug group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
                    {nextArticle.data.title}
                  </span>
                </a>
              )}
            </div>
          </div>
        </footer>

        <ArticleCta />
      </div>
    </main>
  </div>
</Layout>
