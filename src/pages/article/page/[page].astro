---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import PaginationNav from '@/components/article/PaginationNav.astro'
import JsonLdScript from '@/components/seo/JsonLdScript.astro'
import { createBlogSchema, createBreadcrumbSchema } from '@/components/seo/JsonLd'
import Layout from '@/layouts/Layout.astro'
import type { ArticleFeedItem } from '@/types'
import {
  buildArticleFeed,
  getArticleFeedPage,
  microcmsArticleSourceAdapter,
} from '@/lib/articleFeed'
import { toCanonicalUrl } from '@/lib/siteMetadata'
import { formatDateEditorial } from '@/lib/utils'

interface PageProps {
  readonly items: readonly ArticleFeedItem[]
  readonly currentPage: number
  readonly totalPages: number
  readonly totalCount: number
}

export const getStaticPaths = (async () => {
  const PER_PAGE = 12
  const entries = await getCollection('articles')
  const articles = buildArticleFeed([
    {
      adapter: microcmsArticleSourceAdapter,
      items: entries.map((entry) => entry.data),
    },
  ])
  const totalPages = Math.max(1, Math.ceil(articles.length / PER_PAGE))

  return Array.from({ length: totalPages }, (_, index) => {
    const currentPage = index + 1
    const page = getArticleFeedPage(articles, currentPage, PER_PAGE)
    return {
      params: { page: String(currentPage) },
      props: {
        items: page.items,
        currentPage,
        totalPages,
        totalCount: page.totalCount,
      } satisfies PageProps,
    }
  })
}) satisfies GetStaticPaths

const { items, currentPage, totalPages } = Astro.props as PageProps

const pageTitle =
  currentPage === 1
    ? 'Writing | Yunosuke Yoshino'
    : `Writing — Page ${currentPage} | Yunosuke Yoshino`
const description =
  'フロントエンド開発、UI/UXデザイン、モダンなWeb技術についての記事。'
const getPageHref = (page: number) => `/article/page/${page}`

const blogSchema = createBlogSchema()
const breadcrumbSchema = createBreadcrumbSchema([
  { name: 'ホーム', url: toCanonicalUrl('/') },
  { name: 'Writing', url: toCanonicalUrl(`/article/page/${currentPage}`) },
])
---

<Layout
  title={pageTitle}
  description={description}
  robots={currentPage > 1 ? 'noindex, follow' : undefined}
  canonicalPath={`/article/page/${currentPage}`}
  ogType="website"
>
  <JsonLdScript data={blogSchema} />
  <JsonLdScript data={breadcrumbSchema} />
  <section class="mb-[var(--sectiongap)]">
    <header class="mb-10">
      <h1 class="label-mono mb-5">{currentPage === 1 ? 'Writing' : `Writing — Page ${currentPage}`}</h1>
      <p class="text-base text-ink-body">
        フロントエンド開発、UI/UXデザイン、モダンなWeb技術についての記事。
      </p>
    </header>

    {
      items.length === 0 ? (
        <p class="note-row">記事がありません</p>
      ) : (
        <div class="mb-12 flex flex-col article-list">
          {items.map((item) => {
            const isInternal = !item.externalUrl
            const href = item.externalUrl ?? `/article/${item.id}`
            return (
              <a
                class="article-item group block w-full py-2.5 transition-all duration-300"
                href={href}
                {...(!isInternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <div class="flex items-center gap-3 not-italic">
                  <span class="flex min-w-0 items-baseline gap-2">
                    <span class="truncate text-base font-serif italic text-ink-body group-hover:text-ink transition-colors duration-150">
                      {item.title}
                    </span>
                    <span class="text-xs text-ink-soft opacity-75">— {item.category.name}</span>
                  </span>
                  <div class="flex-1 min-w-[12px] self-end mb-1.5">
                    <div class="w-full h-[1px] opacity-25 group-hover:opacity-60 transition-opacity duration-150 dotted-line" />
                  </div>
                  <span class="meta-mono text-ink-faint group-hover:text-ink transition-colors duration-150 whitespace-nowrap">
                    {formatDateEditorial(item.publishedAt)}
                    {!isInternal ? ' ↗' : ''}
                  </span>
                </div>
              </a>
            )
          })}
        </div>
      )
    }

    {
      totalPages > 1 && (
        <PaginationNav
          currentPage={currentPage}
          totalPages={totalPages}
          ariaLabel="ページネーション"
          getPageHref={getPageHref}
        />
      )
    }
  </section>
</Layout>

<style>
  .dotted-line {
    background-image: radial-gradient(circle, var(--color-ink-label) 1px, transparent 1px);
    background-size: 5px 1px;
    background-repeat: repeat-x;
    height: 1px;
  }
  .article-list:hover .article-item:not(:hover) {
    opacity: 0.45;
    filter: blur(0.5px);
  }
</style>
