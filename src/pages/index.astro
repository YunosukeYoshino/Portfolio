---
import JsonLdScript from '@/components/seo/JsonLdScript.astro'
import { createWebsiteSchema } from '@/components/seo/JsonLd'
import Layout from '../layouts/Layout.astro'

// Accept: text/markdown 配信（middleware）を有効にするため SSR 化。
export const prerender = false

// 年代順の主な実績・取り組み
const works = [
  {
    title: 'Building AI Agents & MCP Servers',
    year: '2026',
    url: 'https://github.com/YunosukeYoshino',
  },
  {
    title: 'Building Agent Skill Management App',
    year: '2025',
    url: 'https://github.com/YunosukeYoshino/my-skills',
  },
  {
    title: 'WebGL & Astro Personal Portfolio Site',
    year: '2025',
    url: 'https://yunosukeyoshino.com',
  },
  {
    title: 'Internal Business Application with React & Next.js',
    year: '2024',
    url: 'https://github.com/YunosukeYoshino',
  },
  {
    title: 'Custom E-Commerce Storefront with Shopify',
    year: '2023',
    url: 'https://github.com/YunosukeYoshino',
  },
] as const
---

<Layout siteRoot canonicalPath="/" ogType="website">
  <JsonLdScript data={createWebsiteSchema()} />
  <section class="mb-10 text-base text-ink-body leading-relaxed">
    <p class="mb-4">
      Frontend Engineer focused on building high-performance, delightful web interfaces with React, Astro, and TypeScript.
    </p>
    <p class="mb-5">
      Driving AI-agentic coding with Claude, Codex, Dify, and n8n — bridging fast product execution with automated workflows.
    </p>
    <div class="flex items-center gap-3 meta-mono text-xs text-ink-label">
      <a class="lnk" href="https://github.com/YunosukeYoshino" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span aria-hidden="true" class="opacity-40">•</span>
      <a class="lnk" href="https://www.linkedin.com/in/yunosukeyoshino" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span aria-hidden="true" class="opacity-40">•</span>
      <a class="lnk" href="mailto:hello@yunosukeyoshino.com">Email</a>
    </div>
  </section>

  <section class="mb-[var(--sectiongap)]">
    <h2 class="label-mono mb-5">Selected Works</h2>
    <div class="flex flex-col project-list">
      {works.map((work) => (
        <a
          href={work.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-item group block w-full py-2 transition-all duration-300"
        >
          <div class="flex items-center gap-3 not-italic">
            <span class="text-base font-serif italic text-ink-body group-hover:text-ink transition-colors duration-150">
              {work.title}
            </span>
            <div class="flex-1 min-w-[12px] self-end mb-1.5">
              <div class="w-full h-[1px] opacity-25 group-hover:opacity-60 transition-opacity duration-150 dotted-line"></div>
            </div>
            <span class="meta-mono text-ink-faint group-hover:text-ink transition-colors duration-150">
              {work.year}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-[var(--sectiongap)]">
    <h2 class="label-mono mb-5">Writing</h2>
    <p class="note-row">(Articles coming soon)</p>
  </section>
</Layout>

<style>
  .dotted-line {
    background-image: radial-gradient(circle, var(--color-ink-label) 1px, transparent 1px);
    background-size: 5px 1px;
    background-repeat: repeat-x;
    height: 1px;
  }
  
  /* Sue Park風のホバーエフェクト：ホバー時に対象外のアイテムを薄くぼかす */
  .project-list:hover .project-item:not(:hover) {
    opacity: 0.45;
    filter: blur(0.5px);
  }
</style>
